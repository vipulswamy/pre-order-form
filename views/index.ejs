<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Styled Sign-Up Form</title>
    <!-- Load Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* Custom styles for the final styled card */
      .styled-card {
        /* SAFFRON GRADIENT: Bright Orange/Yellow to Deep Orange */
        background-image: linear-gradient(to bottom right, #ff9933, #ff6600);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
      }
    </style>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              // Defined a new accent color based on Saffron
              "saffron-accent": "#FF9933",
              // Kept indigo for contrast control in other elements if needed
              "primary-indigo": "#4c51bf",
            },
          },
        },
      };

      // --- JAVASCRIPT LOGIC ---

      /*
if (name === "" || whatsappNumber === "") {
  messageElement.textContent = "Error: Please fill in all required fields.";
  return;
}
// Remove event.preventDefault() so it submits to Express
*/

      function handleSignup(event) {
        // 1. Prevents the browser from reloading the page
        event.preventDefault();

        // 2. Get the elements
        const form = document.getElementById("styled-form");

        // Get values from all fields
        const name = form.querySelector('input[name="firstName"]').value;
        const whatsappNumber = form.querySelector(
          'input[name="whatsAppNumber"]'
        ).value; // NEW: Get WhatsApp number
        const messageElement = document.getElementById("styled-form-message");

        // 3. Simple Logic: Check if Name is provided
        if (name === "" || whatsappNumber === "") {
          messageElement.textContent =
            "Error: Please fill in all required fields.";
          messageElement.className = "text-red-500 font-bold mt-2";
          return;
        }

        // 4. Show success message, confirming the name and the WhatsApp contact
        messageElement.textContent = `Success! Welcome, ${name}. We'll contact you at ${whatsappNumber}!`;
        messageElement.className = "text-green-500 font-bold mt-2";

        // 5. Cleanup
        form.reset();
      }

      // --- Attach Event Listener ---
      window.onload = function () {
        // Attach the handler to the styled form only
        document
          .getElementById("styled-form")
          .addEventListener("submit", handleSignup);
      };
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen p-8 font-sans">
    <div class="max-w-4xl mx-auto mb-10 pb-6 border-b border-gray-200">
      <h1 class="text-3xl font-extrabold text-gray-800 mb-2">
        Ashwamedh's Authentic Ashwagandha and Shilajith
      </h1>
      <p class="text-lg text-gray-600">Pre-order today!!</p>
    </div>

    <!-- Main Container: Adjusted to center the single form -->
    <div class="max-w-md mx-auto">
      <!-- ===== STYLED FORM (HTML + CSS + JS) ===== -->
      <div
        class="p-6 styled-card rounded-lg border-2 border-saffron-accent shadow-2xl"
      >
        <h2 class="text-2xl font-bold text-white mb-4">
          Sign Up for Pre-ordering
        </h2>
        <p class="text-gray-100 mb-4">
          Submit your details to receive updates.
        </p>

        <div class="p-6 bg-white rounded-lg">
          <p class="font-semibold text-saffron-accent mb-3">SECURE SIGN-UP</p>

          <!-- THE STYLED HTML FORM -->
          <form id="styled-form" class="space-y-4" action="/" method="POST">
            <div>
              <label
                for="styled-name"
                class="block text-sm font-medium text-gray-700"
                >First Name</label
              >
              <input
                type="text"
                id="styled-name"
                name="firstName"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-saffron-accent focus:border-saffron-accent"
              />
            </div>

            <div>
              <label
                for="styled-lname"
                class="block text-sm font-medium text-gray-700"
                >Last Name</label
              >
              <input
                type="text"
                id="styled-lname"
                name="lastName"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-saffron-accent focus:border-saffron-accent"
              />
            </div>

            <div>
              <label
                for="styled-email"
                class="block text-sm font-medium text-gray-700"
                >Email Address</label
              >
              <input
                type="email"
                id="styled-email"
                name="email"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-saffron-accent focus:border-saffron-accent"
              />
            </div>

            <!-- NEW: WhatsApp Number Field -->
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700"
                >WhatsApp Number</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="e.g., 9876543210"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-saffron-accent focus:border-saffron-accent"
              />
            </div>

            <button
              type="submit"
              class="w-full bg-gray-800 text-saffron-accent py-2 rounded-md font-semibold hover:bg-gray-700 transition duration-150"
            >
              Pre-Order Now
            </button>
          </form>

          <!-- THE JAVASCRIPT FEEDBACK AREA -->
          <div id="styled-form-message" class="text-center mt-4 text-sm"></div>
        </div>
      </div>
    </div>
  </body>
</html>
